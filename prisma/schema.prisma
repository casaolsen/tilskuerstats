// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id      String   @id @default(cuid())
  code    String   @unique // DK, SE, NO
  name    String
  website String?
  leagues League[]
  teams   Team[]
  venues  Venue[]
}

model League {
  id       String   @id @default(cuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      String // e.g. "Superliga", "Allsvenskan", "Eliteserien"
  slug      String   @unique
  tier      Int      @default(1) // 1 = top flight, 2 = second tier, ...
  website   String?
  logoUrl   String?
  seasons   Season[]

  @@unique([countryId, name])
}

model Season {
  id          String       @id @default(cuid())
  leagueId    String
  league      League       @relation(fields: [leagueId], references: [id])
  label       String // "2025/2026" (DK) or "2025" (SE/NO)
  startDate   DateTime?
  endDate     DateTime?
  matches     Match[]
  // Which teams play in this league during this season — the source of
  // truth for promotion/relegation (a team can be in SeasonTeam for
  // Superliga one year and 1. Division the next without becoming a new Team).
  seasonTeams SeasonTeam[]

  @@unique([leagueId, label])
}

model Venue {
  id        String   @id @default(cuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      String
  city      String
  address   String? // for a future map embed
  capacity  Int?
  imageUrl  String?
  website   String?
  teams     Team[]   @relation("HomeVenue")
  matches   Match[]
}

model Team {
  id          String       @id @default(cuid())
  countryId   String
  country     Country      @relation(fields: [countryId], references: [id])
  name        String
  shortName   String?
  slug        String       @unique
  website     String?
  logoUrl     String?
  homeVenueId String?
  homeVenue   Venue?       @relation("HomeVenue", fields: [homeVenueId], references: [id])
  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")
  seasons     SeasonTeam[]
}

// Join table: which teams are registered in which league-season. Lets a team
// move between leagues (promotion/relegation) across seasons while staying
// the same Team record and keeping its full history.
model SeasonTeam {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])

  @@unique([seasonId, teamId])
}

model Match {
  id         String   @id @default(cuid())
  seasonId   String
  season     Season   @relation(fields: [seasonId], references: [id])
  round      Int?
  kickoff    DateTime
  homeTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venueId    String?
  venue      Venue?   @relation(fields: [venueId], references: [id])
  attendance Int?
  homeScore  Int?
  awayScore  Int?
  // Free-text note for anomalies affecting attendance, e.g. a stand closed
  // due to a disciplinary sanction — surfaced as a marker on the frontend.
  note       String?

  // Placeholders for the future prediction feature (history + weather + performance)
  weatherTempC     Float?
  weatherCondition String?
  weatherWindMs    Float?
  weatherPrecipMm  Float?

  source    String? // URL the data was scraped/entered from
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([kickoff])
}
