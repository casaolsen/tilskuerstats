// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Country {
  id      String   @id @default(cuid())
  code    String   @unique // DK, SE, NO
  name    String
  website String?
  leagues League[]
  teams   Team[]
  venues  Venue[]
}

model League {
  id       String   @id @default(cuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      String // e.g. "Superliga", "Allsvenskan", "Eliteserien"
  slug      String   @unique
  tier      Int      @default(1) // 1 = top flight, 2 = second tier, ...
  website   String?
  logoUrl   String?
  seasons   Season[]

  @@unique([countryId, name])
}

model Season {
  id          String       @id @default(cuid())
  leagueId    String
  league      League       @relation(fields: [leagueId], references: [id])
  label       String // "2025/2026" (DK) or "2025" (SE/NO)
  startDate   DateTime?
  endDate     DateTime?
  matches     Match[]
  // Which teams play in this league during this season — the source of
  // truth for promotion/relegation (a team can be in SeasonTeam for
  // Superliga one year and 1. Division the next without becoming a new Team).
  seasonTeams SeasonTeam[]

  @@unique([leagueId, label])
}

model Venue {
  id        String   @id @default(cuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  name      String
  // Nullable rather than required: existing venues get one backfilled by
  // /api/setup (see route.ts) instead of a blocking migration, matching how
  // this project already treats every other optional-but-becomes-common field.
  slug          String?      @unique
  city          String
  address       String? // for a future map embed
  capacity      Int?
  imageUrl      String?
  website       String?
  description   String? // "Om stadion" — free text shown on the venue page
  transportInfo String? // "Sådan kommer du frem" — free text shown on the venue page
  teams         Team[]       @relation("HomeVenue")
  matches       Match[]
  links         VenueLink[]
}

// Admin-managed link shown on the venue page, grouped by category:
// official (stadium site, StadiumDB, ...), review (reviews/videos of the
// matchday experience), or other. Free-form URL/title/description per user
// request — no dedicated fields for specific sources like StadiumDB.
model VenueLink {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id])
  category    String // official | review | other
  title       String
  description String?
  url         String
  createdAt   DateTime @default(now())

  @@index([venueId])
}

model Team {
  id          String       @id @default(cuid())
  countryId   String
  country     Country      @relation(fields: [countryId], references: [id])
  name        String
  shortName   String?
  slug        String       @unique
  website     String?
  logoUrl     String?
  homeVenueId String?
  homeVenue   Venue?       @relation("HomeVenue", fields: [homeVenueId], references: [id])
  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")
  seasons     SeasonTeam[]
}

// Join table: which teams are registered in which league-season. Lets a team
// move between leagues (promotion/relegation) across seasons while staying
// the same Team record and keeping its full history.
model SeasonTeam {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])

  @@unique([seasonId, teamId])
}

model Match {
  id         String   @id @default(cuid())
  seasonId   String
  season     Season   @relation(fields: [seasonId], references: [id])
  round      Int?
  kickoff    DateTime
  homeTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  venueId    String?
  venue      Venue?   @relation(fields: [venueId], references: [id])
  attendance Int?
  homeScore  Int?
  awayScore  Int?
  // Free-text note for anomalies affecting attendance, e.g. a stand closed
  // due to a disciplinary sanction — surfaced as a marker on the frontend.
  note       String?

  // Placeholders for the future prediction feature (history + weather + performance)
  weatherTempC     Float?
  weatherCondition String?
  weatherWindMs    Float?
  weatherPrecipMm  Float?

  source    String? // URL the data was scraped/entered from
  // Set when the insight agent has looked at this match (see src/insights/).
  insightCheckedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([kickoff])
}

// One run of the insight agent (src/insights/). Stores the full message
// transcript so you can see in /admin/insights why the agent did what it did.
model InsightRun {
  id         String         @id @default(cuid())
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  model      String
  status     String // running | done | max_turns | refusal | error | nothing_new
  matchIds   Json // matches that were new when the run started
  summary    String? // the agent's closing message
  toolCalls  Json? // [{turn, name, input, isError, output}]
  transcript Json?
  usage      Json?
  drafts     InsightDraft[]
}

// An insight written by the agent. Nothing is shown publicly until an admin
// approves it.
model InsightDraft {
  id         String     @id @default(cuid())
  runId      String
  run        InsightRun @relation(fields: [runId], references: [id])
  createdAt  DateTime   @default(now())
  status     String     @default("pending") // pending | approved | rejected
  kind       String // record | outlier | trend | milestone | other
  headline   String
  body       String
  matchIds   Json
  evidence   Json // [{claim, tool_use_id, tool, input, result}]
  reviewedAt DateTime?
  reviewNote String?

  @@index([status])
}
